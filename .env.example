# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/messenger_db"

# Server Port
PORT=3000

# JWT Configuration
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="7d"

# MinIO Object Storage Configuration
# Endpoint backend ket noi noi bo (khi chay Docker network hoac local)
MINIO_INTERNAL_ENDPOINT="http://127.0.0.1:9000"
# Endpoint public de client trinh duyet truy cap
MINIO_PUBLIC_ENDPOINT="http://127.0.0.1:9000"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY="change_this_to_strong_access_key"
MINIO_SECRET_KEY="change_this_to_strong_secret_key"
MINIO_BUCKET="messenger-media"
MINIO_PUBLIC_READ="true"

